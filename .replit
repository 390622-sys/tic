modules = ["nodejs-24"]
run = "node server.js"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Start Server"

[[workflows.workflow]]
name = "Start Server"
mode = "sequential"
author = "user"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081
